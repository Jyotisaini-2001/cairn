build/
dist/

# Runtime state — NEVER commit the live databases. A git checkout/stash that
# rewrites a .db under a running process swaps its inode and wedges every open
# connection ("attempt to write a readonly database"). Local data stays local.
data/
*.db
*.db-shm
*.db-wal

# Env / secrets (never commit real tokens)
.env
.env.local

# Claude Code local config — not part of the project
.claude/

# Placeholder / scratch dirs
slack_events/

